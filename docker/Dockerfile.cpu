# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm AS dependencies
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /bin/uv
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --no-build

FROM python:3.12-slim-bookworm AS prod
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/workspace/src:/workspace" \
    HF_HOME=/home/app/.cache/huggingface \
    GRADIO_SERVER_NAME=0.0.0.0 \
    GRADIO_SERVER_PORT=7860 \
    GRADIO_SHARE=0
RUN useradd --create-home --uid 1000 app \
    && mkdir -p /workspace /home/app/.cache/huggingface \
    && chown -R app:app /workspace /home/app
WORKDIR /workspace
COPY --from=dependencies /opt/venv /opt/venv
COPY --chown=app:app src/ src/
COPY --chown=app:app apps/ apps/
COPY --chown=app:app config.yaml ./
COPY --chown=app:app examples/audio_ref/ examples/audio_ref/
USER app
EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:7860/', timeout=3)"
CMD ["python", "apps/gradio_main.py"]
