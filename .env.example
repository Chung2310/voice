# CPU VPS; copy to .env. Do not commit credentials.
IMAGE_NAME=vieneu-tts
IMAGE_TAG=cpu
# web, api, or web,api (both load their own models and use more RAM).
COMPOSE_PROFILES=web
BIND_ADDRESS=127.0.0.1
PORT=7860
API_PORT=8000
HF_HOME=/home/app/.cache/huggingface
HF_TOKEN=
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=0
VIENEU_WEB_AUTH=
VIENEU_API_KEY=
VIENEU_PRECISION=fp32
VIENEU_MAX_STREAMS=1
VIENEU_QUEUE=4
VIENEU_QUEUE_TIMEOUT=10
